<!DOCTYPE html>
<html lang="zh-CN">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>UMA_Project</title>
   <style>
       body, html {
           margin: 0;
           padding: 0;
           width: 100%;
           height: 100%;
           overflow: hidden;
           display: flex;
           flex-direction: column;
           align-items: center;
           justify-content: space-between;
           font-family: sans-serif;
           background-color: #ffffff;
       }

       /* 标题区域 */
       .title-container {
           flex-grow: 1;
           display: flex;
           align-items: center;
           justify-content: center;
           width: 100%;
       }

       .title {
           font-size: 12vw; /* 响应式放大字体 */
           font-weight: 900;
           color: black;
           text-align: center;
           line-height: 1;
       }

       /* 底部按钮区域 */
       .button-container {
           display: flex;
           flex-direction: column;
           gap: 20px;
           margin-bottom: 50px;
           width: 100%;
           align-items: center;
           justify-content: center;
       }

       @media (min-width: 768px) {
           .button-container {
               flex-direction: row;
               gap: 40px;
           }
           .title {
               font-size: 80px;
           }
       }

       /* 蓝色椭圆形按钮 */
       .btn {
           display: flex;
           align-items: center;
           justify-content: center;
           background-color: #007bff; /* 蓝色 */
           color: white;
           text-decoration: none;
           padding: 15px 40px;
           border-radius: 50px; /* 椭圆形状 */
           font-size: 18px;
           font-weight: bold;
           box-shadow: 0 4px 6px rgba(0,0,0,0.1);
           transition: transform 0.1s ease, background-color 0.2s;
           min-width: 160px;
           text-align: center;
           border: none;
           outline: none;
           cursor: pointer;
       }

       .btn:hover {
           background-color: #0056b3;
       }

       .btn:active {
           transform: scale(0.95);
       }
   </style>
</head>
<body>

   <div class="title-container">
       <div class="title">UMA_Project.</div>
   </div>

   <div class="button-container">
       <a href="https://qm.qq.com/q/81ivbuW2sM" class="btn" target="_blank">QQ群聊</a>
       <a href="https://t.me/umaproject2025" class="btn" target="_blank">Telegram频道</a>
       <a href="http://SWXL.tipian02.cn/l1_JM2E95D" class="btn" target="_blank">Other</a>
   </div>

   <script>
       // 尝试自动全屏逻辑 (浏览器通常需要用户交互才能触发全屏)
       function toggleFullScreen() {
           if (!document.fullscreenElement) {
               document.documentElement.requestFullscreen().catch((e) => {
                   // 静默失败，部分浏览器不允许自动全屏
               });
           }
       }

       // 页面加载完成后尝试全屏
       window.addEventListener('load', () => {
            // 某些特殊环境可能允许自动全屏
           setTimeout(toggleFullScreen, 100);
       });

       // 用户点击页面任意位置时触发全屏
       document.body.addEventListener('click', toggleFullScreen);
   </script>

</body>
</html>
